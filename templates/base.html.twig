<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="Description" content="Pain Boudin Record">
    <meta name="theme-color" content="#383838">
    <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">
    <link rel="manifest" href="{{ asset('build/manifest.json') }}">
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    <title>{% block title %}Pain Boudin Record{% endblock %}</title>
</head>
<body>
<noscript>
    You need to enable JavaScript to run this app.
</noscript>
<div id="root"></div>
<script>
    window.__PRELOADED_STATE__ = {
        'user': {% if app.user %} { {% for key,value in getTwitchConnectState() %}
            '{{ key }}': '{{ value }}',{% endfor %} } {% else %} false {% endif %},
        'rank': [ {% for rank in getRanking() %} { {% for key,value in rank %}
            '{{ key }}': '{{ value }}',{% endfor %} }, {% endfor %} ],
        'songs': [ {% for song in getSongs() %} {
            'id': '{{ song.id }}',
            'type': '{{ song.type }}',
            'visual': '{{ song.visual }}'
        }, {% endfor %} ],
        'mixes': [ {% for mix in getMixes() %} {
            'id': '{{ mix.id }}',
            'type': '{{ mix.type }}',
            'visual': '{{ mix.visual }}'
        }, {% endfor %} ],
        'posts': { {% for insta in getPosts() %} '{{ loop.index }}': '{{ insta }}', {% endfor %} },
        'videos': { {% for youtube in getVideos() %} '{{ loop.index }}': '{{ youtube }}', {% endfor %} },
        'admin': {% if isAdmin() == true %}true{% else %}false{% endif %}
    };
</script>
<script type="text/javascript" src="https://embed.twitch.tv/embed/v1.js"></script>
<script type="text/javascript" src="{{ asset('build/runtime.js') }}"></script>
<script type="text/javascript" src="{{ asset('build/app.js') }}"></script>
{% block body %}{% endblock %}
</body>
</html>
