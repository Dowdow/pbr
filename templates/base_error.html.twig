<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="Description" content="Pain Boudin Record">
    <meta name="theme-color" content="#383838">
    <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">
    <link rel="manifest" href="{{ asset('build/manifest.json') }}">
    <link href="https://fonts.googleapis.com/css?family=Baloo" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Montserrat" rel="stylesheet">
    <title>Pain Boudin Record - Error</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            background: #eef0f2 url("{{ asset('build/images/footer.ac6a0138.png')}}") no-repeat center;
            background-position-y: 220px;
        }

        header {
            width: 100%;
            height: 200px;
            background-color: #383838;
        }

        header h1 {
            font-family: 'Baloo', sans-serif;
            font-weight: normal;
            font-size: 64px;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin: 0;
            color: #F7EFDC;
            text-align: center;
            padding-top: 40px;
        }

        section {
            width: 100%;
            text-align: center;
        }

        section h2 {
            font-family: 'Montserrat', sans-serif;
            font-size: 30px;
            color: #383838;
            margin-top: 100px;
        }

        section a {
            font-family: 'Montserrat', sans-serif;
            font-weight: normal;
            font-size: 25px;
            color: #383838;
        }

        @media screen and (max-width: 768px) {
            header h1 {
                font-size: 40px;
                line-height: 60px;
            }
        }
    </style>
    <style>{% block style %}{% endblock %}</style>
</head>
<body>
<header>
    <h1>Pain Boudin Record</h1>
</header>
<section>
    {% block content %}
    {% endblock %}
</section>
</body>
</html>