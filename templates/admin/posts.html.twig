{% extends 'admin/base.html.twig' %}

{% block content %}
    <h2>Add a post</h2>
    <div class="row">
        {{ form_start(postForm) }}
        <div class="form-group">
            {{ form_label(postForm.instaId) }}
            {{ form_widget(postForm.instaId, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="form-group">
            {{ form_label(postForm.sort) }}
            {{ form_widget(postForm.sort, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="form-group form-check">
            {{ form_widget(postForm.activated, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(postForm.activated, 'Activated', {'label_attr': {'class': 'form-check-label'}}) }}
        </div>
        <div class="form-group">
            {{ form_widget(postForm.save, {'attr': {'class': 'btn btn-primary'}}) }}
        </div>
        {{ form_end(postForm) }}
    </div>
    <h2>Posts</h2>
    <div class="row">
        <table class="table">
            <thead>
            <tr>
                <td>ID</td>
                <td>Insta ID</td>
                <td>Sort</td>
                <td>Activated</td>
                <td>Delete</td>
            </tr>
            </thead>
            <tbody>
            {% for post in posts %}
                <tr>
                    <td>{{ post.id }}</td>
                    <td>{{ post.instaId }}</td>
                    <td>
                        <input type="number" class="form-control sort" name="{{ post.id }}" value="{{ post.sort }}">
                    </td>
                    <td>
                        <form method="post">
                            <button type="submit" name="activation_post" value="{{ post.id }}" class="btn btn-primary">
                                {% if post.activated %}
                                    Deactivate
                                {% else %}
                                    Activate
                                {% endif %}
                            </button>
                        </form>
                    </td>
                    <td>
                        <form method="post">
                            <button type="submit" name="delete_post" value="{{ post.id }}" class="btn btn-danger">Delete
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block js %}
    <script>
        const $sort = document.getElementsByClassName('sort');
        for (let i = 0; i < $sort.length; i++) {
            if ($sort.hasOwnProperty(i)) {
                $sort[i].onchange = (e) => {
                    const id = e.target.name;
                    const value = e.target.value;
                    fetch(`{{ path('admin_posts_sort') }}?id=${id}&sort=${value}`)
                        .then(response => {
                            return response.json();
                        })
                        .then(data => {
                            if (data.message === 'Ok') {
                                e.target.classList.add('border-success');
                            }
                        })
                        .catch(() => {
                            e.target.classList.add('border-danger');
                        });
                }
            }
        }
    </script>
{% endblock %}