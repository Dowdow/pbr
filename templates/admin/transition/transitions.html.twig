{% extends 'admin/base.html.twig' %}

{% block content %}
	<div class="d-flex flex-row justify-content-between mt-4 mb-4">
		<h2>Transitions</h2>
		<a href="{{ path('admin_transitions_create') }}" class="btn btn-primary active align-self-center" role="button" aria-pressed="true">Add a transition</a>
	</div>
	<div class="row">
		<table class="table">
			<thead>
				<tr>
					<th scope="col">ID</th>
					<th scope="col">Name</th>
					<th scope="col">Audio</th>
					<th scope="col">Edit</th>
					<th scope="col">Delete</th>
				</tr>
			</thead>
			<tbody>
				{% for transition in transitions %}
					<tr>
						<th scope="row">{{ transition.id }}</th>
						<td>{{ transition.name }}</td>
						<td>
							<audio controls src="{{ asset('transitions/' ~ transition.fileName) }}"></audio>
						</td>
						<td>
							<a href="{{ path('admin_transitions_edit', {'id': transition.id}) }}" class="btn btn-primary" role="button" aria-pressed="true">Edit</a>
						</td>
						<td>
							<form method="post">
								<button type="submit" name="delete_transition" value="{{ transition.id }}" class="btn btn-danger">Delete
								</button>
							</form>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
