<div class="row">
    {{ form_start(songForm) }}
    <div class="form-group">
        {{ form_label(songForm.soundcloudId) }}
        {{ form_widget(songForm.soundcloudId, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="form-group">
        {{ form_label(songForm.type) }}
        {{ form_widget(songForm.type, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="form-group">
        {{ form_label(songForm.category) }}
        {{ form_widget(songForm.category, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="form-group">
        {{ form_label(songForm.sort) }}
        {{ form_widget(songForm.sort, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="form-group form-check">
        {{ form_widget(songForm.visual, {'attr': {'class': 'form-check-input'}}) }}
        {{ form_label(songForm.visual, 'Visual', {'label_attr': {'class': 'form-check-label'}}) }}
    </div>
    <div class="form-group form-check">
        {{ form_widget(songForm.activated, {'attr': {'class': 'form-check-input'}}) }}
        {{ form_label(songForm.activated, 'Activated', {'label_attr': {'class': 'form-check-label'}}) }}
    </div>
    <div class="form-group">
        {{ form_widget(songForm.save, {'attr': {'class': 'btn btn-primary'}}) }}
        <a href="{{ path('admin_songs') }}">Back</a>
    </div>
    {{ form_end(songForm) }}
</div>