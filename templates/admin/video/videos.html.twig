{% extends 'admin/base.html.twig' %}

{% block content %}
    <div style="display: flex; flex-direction: row; justify-content: space-between">
        <h2>Videos</h2>
        <a href="{{ path('admin_videos_create') }}" style="align-self: center;"
           class="btn btn-primary active" role="button" aria-pressed="true">Add a video</a>
    </div>
    <div class="row">
        <table class="table">
            <thead>
            <tr>
                <th>ID</th>
                <th>YouTube ID</th>
                <th>Sort</th>
                <th>Activated</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
            </thead>
            <tbody>
            {% for video in videos %}
                <tr>
                    <td>{{ video.id }}</td>
                    <td><a href="https://www.youtube.com/watch?v={{ video.youtubeId }}" target="_blank"
                           rel="noopener">{{ video.youtubeId }}</a></td>
                    <td>
                        <input type="number" class="form-control sort" name="{{ video.id }}" value="{{ video.sort }}">
                    </td>
                    <td>
                        <form method="post">
                            <button type="submit" name="activation_video" value="{{ video.id }}"
                                    class="btn btn-primary">
                                {% if video.activated %}
                                    Deactivate
                                {% else %}
                                    Activate
                                {% endif %}
                            </button>
                        </form>
                    </td>
                    <td>
                        <a href="{{ path('admin_videos_edit', {'id': video.id}) }}"
                           class="btn btn-primary" role="button" aria-pressed="true">Edit</a>
                    </td>
                    <td>
                        <form method="post">
                            <button type="submit" name="delete_video" value="{{ video.id }}" class="btn btn-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block js %}
    <script>
        const $sort = document.getElementsByClassName('sort');
        for (let i = 0; i < $sort.length; i++) {
            if ($sort.hasOwnProperty(i)) {
                $sort[i].onchange = (e) => {
                    const id = e.target.name;
                    const value = e.target.value;
                    fetch(`{{ path('admin_videos_sort') }}?id=${id}&sort=${value}`)
                        .then(response => {
                            return response.json();
                        })
                        .then(data => {
                            if (data.message === 'Ok') {
                                e.target.classList.add('border-success');
                            }
                        })
                        .catch(() => {
                            e.target.classList.add('border-danger');
                        });
                }
            }
        }
    </script>
{% endblock %}